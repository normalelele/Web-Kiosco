<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fisco.Pay</title>
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script type="module" src="~/lib/jquery/dist/jquery.js"></script>
    <script type="module" src="~/js/Home/Index.js"></script>
    <script type="module" src="~/js/site.js"></script>
</head>
<body>
    <main class="main-content">
        <div id="carouselExampleSlidesOnly" class="carousel slide h-100" data-bs-ride="carousel">
            <div class="carousel-inner h-100">
                <div class="carousel-item active h-100" data-bs-interval="2000">
                    <img src="~/images/valledupar.jpg" class="d-block w-100 h-100" alt="..." style="object-fit: cover;">
                </div>
                <div class="carousel-item h-100" data-bs-interval="2000">
                    <img src="~/images/enduparFolder.jpg" class="d-block w-100 h-100" alt="..." style="object-fit: cover;">
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <button id="tapToStartButton" name="tapToStartButton" class="btn btn-primary btn-lg rounded-pill p-5 fs-1">
            TOQUE PARA COMENZAR
        </button>
    </footer>
</body>
</html>