<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fisco.Pay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="header">
        <div class="ms-4">
            <h1 style="color: #FFFFFF">Alcaldía de Valledupar</h1>
            <h6 style="color: #FFFFFF">Bienvenidos al portal de pagos</h6>
        </div>
    </div>

    <div class="main-content">
        <div>
            <img src="~/images/Refused.png" width="120" alt="Rechazado">
        </div>

        <h3 class="">Pago rechazado</h3>

        <p class="mt-4" style="color: #ADB5BD">Comuníquese con su Entidad Financiera</p>
    </div>

    <div class="footer">
        <button class="btn btn-secondary btn-lg rounded-pill">Regresar a la página principal</button>
    </div>
</body>
</html>
