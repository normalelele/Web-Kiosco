<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fisco.Pay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="module" src="~/lib/jquery/dist/jquery.js"></script>
    <script type="module" src="~/lib/jquery/dist/jquery.min.js"></script>
    <script type="module" src="~/js/Home/PaymentPortalEntity.js"></script>
</head>
<body>
    <div class="header">
        <div class="ms-4">
            <h1 style="color: #FFFFFF">Bienvenido al portal de pagos</h1>
        </div>
    </div>

    <div class="main-content">
        <h2 class="mb-5" style="color: #00205c">Seleccione la entidad a la que corresponde el pago</h2>

        <div class="cards">
            <div id="" name="" class="card">
                <img src="~/images/GobCesar2020.png" alt="Gobernación del Cesar">
                <h6>Gobernación del Cesar</h6>
            </div>

            <div id="cardAlcaldia" name="cardAlcaldia" class="card">
                <img src="~/images/alcaldiaValledupar.png" alt="Alcaldía de Valledupar">
                <h6>Alcaldía de Valledupar</h6>
            </div>
        </div>

        <div class="cards mt-5">
            <div id="" name="" class="card">
                <img src="~/images/emdupar.png" alt="Emdupar">
                <h6>Emdupar</h6>
            </div>

            <div id="" name="" class="card">
                <img src="~/images/afinia.png" alt="Afinia">
                <h6>Afinia</h6>
            </div>
        </div>

    </div>

</body>
</html>
