<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fisco.Pay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/Payments/MethodOfPayment.js"></script>
    <style>
        .divCenter {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="ms-4">
            <h1 style="color: #FFFFFF">Alcaldía de Valledupar</h1>
            <h6 style="color: #FFFFFF">Bienvenidos al portal de pagos</h6>
        </div>
    </div>

    <div class="main-content">

        <div class="divCenter mt-1 mb-4">
            <h6>Resumen del pago</h6>
            <spam>Impuesto: Predial unificado</spam>
            <span>Periodos: 2020, 2021, 2024, 2025</span>
        </div>

        <div class="divCenter">
            <h3>Total a pagar</h3>
            <h1>$650.000</h1>
        </div>

        <h4 class="mt-5">Elija la forma de pago</h4>

        <div class="cards mt-3">
            <div class="card">
                <img src="~/images/codigoQr.png" alt="Escaneeel código QR">
                <h6>Escanee el código QR</h6>
            </div>

            <div class="card">
                <img id="cardDataPhone" name="cardDataPhone" src="~/images/tarjetaDebito.png" alt="Tarjeta Débito/Crédito">
                <h6>Tarjeta Débito/Crédito</h6>
            </div>
        </div>
    </div>

    <div class="footer">
        <button id="backButton" name="backButton" class="btn btn-secondary btn-lg rounded-pill">Atrás</button>
    </div>
</body>
</html>
