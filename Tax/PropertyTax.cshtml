<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fisco.Pay</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script type="module" src="~/js/Tax/PropertyTax.js"></script>
    <style>
        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .numeric-keyboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            width: 250px;
            margin-top: 15px;
        }

        .numeric-key {
            width: 100%;
            height: 60px;
            font-size: 1.5rem;
            border: 1px solid #ccc;
            background-color: #f8f9fa;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            line-height: 60px;
        }

            .numeric-key:active {
                background-color: #758bb2;
            }

        .input-field {
            width: 250px;
            height: 50px;
            text-align: center;
            font-size: 1.5rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            margin-top: 15px;
        }

        .text-tax {
            position: absolute;
            top: 14px;
        }

        .input-field.error {
            border: 2px solid red;
        }

        .text-danger {
            color: red;
            font-size: 0.875rem;
            margin-top: 5px;
            display: block;
        }
    </style>
</head>

<body>
    <header class="header">
        <div class="ms-4">
            <h1 style="color: #FFFFFF">Alcaldía de Valledupar</h1>
            <h6 style="color: #FFFFFF">Bienvenidos al portal de pagos</h6>
        </div>
    </header>

    <main class="main-content">
        <div class="w-100 ps-3">
            <h6 class="ps-2 text-start text-tax">Impuesto Predial Unificado</h6>
        </div>

        <h4 class="mb-4">Elija el criterio de consulta</h4>

        <div class="m-0 p-0 mb-2">
            <div class="form-check">
                <input id="radioIdentificationNumber" name="searchCriteria" class="form-check-input" type="radio" checked>
                <label class="form-check-label" for="radioIdentificationNumber">Número de identificación</label>
            </div>

            <div class="form-check">
                <input id="radioReference" name="searchCriteria" class="form-check-input" type="radio">
                <label class="form-check-label" for="radioReference">Referencia catastral</label>
            </div>

            <div class="form-check">
                <input id="radioRealEstateRegistration" name="searchCriteria" class="form-check-input" type="radio">
                <label class="form-check-label" for="radioRealEstateRegistration">Matrícula inmobiliaria</label>
            </div>
        </div>

        <input id="numberInput" name="numberInput" class="input-field m-0 p-0 mt-4" type="text" readonly>
        <span id="errorMessage" class="text-danger d-none">Este campo es obligatorio.</span>
        <span id="noResultsMessage" class="text-danger d-none">No hay resultados con este valor.</span>

        <div class="numeric-keyboard">
            <button id="prueba" class="numeric-key">1</button>
            <button class="numeric-key">2</button>
            <button class="numeric-key">3</button>
            <button class="numeric-key">4</button>
            <button class="numeric-key">5</button>
            <button class="numeric-key">6</button>
            <button class="numeric-key">7</button>
            <button class="numeric-key">8</button>
            <button class="numeric-key">9</button>
            <button id="btnDelete" class="numeric-key">⌫</button>
            <button class="numeric-key">0</button>
            <button id="btnClean" class="numeric-key">C</button>
        </div>
    </main>

    <footer class="footer m-0 p-0 ms-1">
        <button id="backButton" class="btn btn-secondary btn-lg rounded-pill ms-2 me-2">Atrás</button>
        <button id="continueButton" class="btn btn-success btn-lg rounded-pill ms-2 me-2">Continuar</button>
    </footer>

</body>
</html>
