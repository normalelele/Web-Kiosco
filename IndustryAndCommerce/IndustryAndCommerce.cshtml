<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fisco.Pay</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/js/IndustryAndCommerce/IndustryAndCommerce.js"></script>
    <style>
        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .numeric-keyboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            width: 250px;
            margin-top: 15px;
        }

        .numeric-key {
            width: 100%;
            height: 60px;
            font-size: 1.5rem;
            border: 1px solid #ccc;
            background-color: #f8f9fa;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            line-height: 60px;
        }

            .numeric-key:active {
                background-color: #ddd;
            }

        .input-field {
            width: 250px;
            height: 50px;
            text-align: center;
            font-size: 1.5rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            margin-top: 15px;
        }

        .text-tax {
            position: absolute;
            top: 14px;
        }
    </style>
</head>

<body>
    <header class="header">
        <div class="ms-4">
            <h1 style="color: #FFFFFF">Alcaldía de Valledupar</h1>
            <h6 style="color: #FFFFFF">Bienvenidos al portal de pagos</h6>
        </div>
    </header>

    <main class="main-content">
        <div class="w-100 ps-3">
            <h6 class="ps-2 text-start text-tax">Industria y Comercio</h6>
        </div>

        <h4 class="mb-4">Elija el criterio de consulta</h4>

        <div class="m-0 p-0 mb-2">
            <div class="form-check">
                <input id="radio1" name="searchCriteria" class="form-check-input" type="radio">
                <label class="form-check-label" for="radio1">Número de identificación</label>
            </div>
        </div>

        <input id="numeroInput" class="input-field m-0 p-0 mt-4" type="text" readonly>

        <div class="numeric-keyboard">
            <button class="numeric-key">1</button>
            <button class="numeric-key">2</button>
            <button class="numeric-key">3</button>
            <button class="numeric-key">4</button>
            <button class="numeric-key">5</button>
            <button class="numeric-key">6</button>
            <button class="numeric-key">7</button>
            <button class="numeric-key">8</button>
            <button class="numeric-key">9</button>
            <button class="numeric-key" id="btnDelete">⌫</button>
            <button class="numeric-key">0</button>
            <button class="numeric-key" id="btnClean">C</button>
        </div>

    </main>

    <footer class="footer m-0 p-0 ms-1">
        <button id="backButton" name="backButton" class="btn btn-secondary btn-lg rounded-pill ms-2 me-2">Atrás</button>
        <button id="" name="" class="btn btn-success btn-lg rounded-pill ms-2 me-2">Continuar</button>
    </footer>

</body>
</html>